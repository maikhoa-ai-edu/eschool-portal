# eSchool Portal - cấu hình cho hosting Apache/cPanel
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Thẻ OG từng bài, sitemap, robots do seo.php tạo (hosting không có PHP vẫn chạy nhờ bỏ qua khi thiếu file)
  RewriteCond %{DOCUMENT_ROOT}/seo.php -f
  RewriteRule ^(sitemap\.xml|robots\.txt|tin-tuc/[a-z0-9-]+|thong-bao/[0-9a-f-]+|van-ban/[0-9a-f-]+|thu-vien-anh/[a-z0-9-]+|trang/[a-z0-9-]+|chuyen-de/[a-z0-9-]+)?$ seo.php [L]
  # File/thư mục có thật thì phục vụ trực tiếp, còn lại trả về index.html (SPA)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "^(index\.html|config\.json|sw\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|woff2|svg|png|jpe?g|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml application/sql
</IfModule>

# File khóa và file tạm của install.php không cần đọc từ trình duyệt
<FilesMatch "^\.eschool-install\.lock$|\.tmp$">
  Require all denied
</FilesMatch>
