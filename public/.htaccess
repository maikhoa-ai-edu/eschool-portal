# eSchool Portal - cấu hình cho hosting Apache/cPanel
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # File/thư mục có thật thì phục vụ trực tiếp, còn lại trả về index.html (SPA)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "^(index\.html|config\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2|svg|png|jpe?g|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# File khóa và file tạm của install.php không cần đọc từ trình duyệt
<FilesMatch "^\.eschool-install\.lock$|\.tmp$">
  Require all denied
</FilesMatch>
