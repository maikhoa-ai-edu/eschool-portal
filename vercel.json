{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/seo?path=/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/api/seo?path=/robots.txt" },
    { "source": "/tin-tuc/:slug([a-z0-9-]+)", "destination": "/api/seo?path=/tin-tuc/:slug" },
    { "source": "/thong-bao/:id([0-9a-f-]+)", "destination": "/api/seo?path=/thong-bao/:id" },
    { "source": "/van-ban/:id([0-9a-f-]+)", "destination": "/api/seo?path=/van-ban/:id" },
    { "source": "/thu-vien-anh/:slug([a-z0-9-]+)", "destination": "/api/seo?path=/thu-vien-anh/:slug" },
    { "source": "/trang/:slug([a-z0-9-]+)", "destination": "/api/seo?path=/trang/:slug" },
    { "source": "/chuyen-de/:slug([a-z0-9-]+)", "destination": "/api/seo?path=/chuyen-de/:slug" },
    { "source": "/((?!assets/|api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(config.json|sw.js)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
